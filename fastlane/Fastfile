require 'dotenv/load'

default_platform(:ios)

platform :ios do
  desc "Create/fetch the Apple Distribution certificate and install it into the local keychain (run once, locally)"
  lane :certificates do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Creates a new Apple Distribution cert (or reuses an existing one whose key
    # is present) for the team in the Appfile, installs it into the keychain,
    # and writes the .cer/.p12 to ./certs.
    cert(
      api_key: api_key,
      development: false,
      output_path: "./certs"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Load API key from environment
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Derive the next build number from TestFlight so CI runs stay unique
    # without committing the bumped value back to the repo.
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "systems.weekend.JackApp",
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "JackApp.xcodeproj",
      build_number: latest_build + 1
    )

    # Fetch (or create) the App Store distribution provisioning profile via the
    # API key, and install it. This avoids automatic signing, which needs an
    # interactive Apple ID in Xcode that CI runners don't have.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "systems.weekend.JackApp",
      readonly: false
    )

    # Switch the project to manual signing using the cert + profile we just set up.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "JackApp.xcodeproj",
      team_id: "3DB2G9C8Z2",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["JackApp"],
      build_configurations: ["Release"]
    )

    # Build the app with explicit (manual) signing.
    build_app(
      scheme: "JackApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "systems.weekend.JackApp" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    # Upload to TestFlight with metadata
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    # Update App Store metadata (optional - comment out if no App Store version exists yet)
    # deliver(
    #   api_key: api_key,
    #   skip_binary_upload: true,
    #   skip_screenshots: true,
    #   force: true,
    #   precheck_include_in_app_purchases: false
    # )
  end
end
