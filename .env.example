# App Store Connect API Key Configuration
# Copy this file to .env and fill in your values

# Your API Key ID (found in App Store Connect > Users and Access > Keys)
ASC_KEY_ID=YOUR_KEY_ID_HERE

# Your Issuer ID (found in App Store Connect > Users and Access > Keys)
ASC_ISSUER_ID=YOUR_ISSUER_ID_HERE

# Base64 encoded contents of your .p8 file
# Generate with: base64 -i AuthKey_XXXXXX.p8 | tr -d '\n'
ASC_KEY_CONTENT=YOUR_BASE64_ENCODED_P8_KEY_HERE
